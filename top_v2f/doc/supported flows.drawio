        <mxCell id="mwrcRj_gNHAAUkLUHhGO-31" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Lua Scripted Flow (CLI only)&lt;/h1&gt;&lt;p&gt;Designs that want to leverage Verilog must use the scripted Lua flow. The orange to blue path describes all the steps necessary.&lt;/p&gt;&lt;p&gt;Each block and ellipse can be manipulated in your script.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="440" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mwrcRj_gNHAAUkLUHhGO-32" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;GUI Flow (available anywhere)&lt;/h1&gt;&lt;p&gt;Designs that want to omit the scripting in favour of a more interactive tool can use the web GUI.&lt;/p&gt;&lt;p&gt;If using a native installation, then Lua scripting and Verilog can be used.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="440" x="40" y="650" as="geometry" />
